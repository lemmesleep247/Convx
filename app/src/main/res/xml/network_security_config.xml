<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Secure default: no cleartext. LAN Listen-Together uses wss/http on
         private hosts via explicit domain-config below, not a global opt-out. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Debug-only: lets a debug build be MITM-inspected (PCAPdroid, mitmproxy) for
         diagnosing network issues. Never applies to release builds regardless of
         this block's presence — debug-overrides is only honored when the APK is
         built with android:debuggable="true". -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
